{
  "name": "desk_story",
  "description": "5 s choreographed: a task card glides to Doing on the Task Wall, the camera swoops into the studio as Marlow walks over from the lounge, sits down at his desk and says he is on it",
  "duration": 5,
  "setup": {
    "time": 12600,
    "weather": "clear",
    "foreman": {
      "minAgents": 6,
      "requireShowcase": true
    },
    "requests": [
      {
        "type": "dev.foreman.inject",
        "patch": {
          "agent": "marlow",
          "set": {
            "station": "lounge",
            "state": "idle",
            "activity": "taking a break",
            "taskId": null
          }
        }
      },
      {
        "type": "dev.foreman.inject",
        "patch": {
          "task": "t6",
          "set": {
            "status": "todo",
            "assignee": null
          }
        }
      },
      {
        "type": "dev.wait",
        "frames": 5
      }
    ]
  },
  "foreman": {
    "hold": true,
    "release": "reconnect"
  },
  "camera": {
    "type": "keys",
    "fov": 64,
    "keys": [
      {
        "t": 0,
        "x": -3.6,
        "y": 69.3,
        "z": 12.2,
        "lookAt": {
          "x": -7.9,
          "y": 68.6,
          "z": 15.6
        }
      },
      {
        "t": 1.5,
        "x": -1.4,
        "y": 69.3,
        "z": 12.5,
        "lookAt": {
          "x": -7.9,
          "y": 68.6,
          "z": 15.3
        }
      },
      {
        "t": 2.2,
        "x": 0.6,
        "y": 69.2,
        "z": 8.4,
        "lookAt": {
          "x": -6.8,
          "y": 67.9,
          "z": 0.8
        }
      },
      {
        "t": 3.6,
        "x": -2.6,
        "y": 69,
        "z": -0.6,
        "lookAt": {
          "x": -7.5,
          "y": 67.6,
          "z": -7.4
        }
      },
      {
        "t": 5,
        "x": -3,
        "y": 68.9,
        "z": -1.2,
        "lookAt": {
          "x": -7.5,
          "y": 67.5,
          "z": -7.5
        }
      }
    ]
  },
  "timeline": [
    {
      "t": 0.4,
      "patch": {
        "task": "t6",
        "set": {
          "status": "doing",
          "assignee": "marlow"
        }
      }
    },
    {
      "t": 0.6,
      "patch": {
        "agent": "marlow",
        "set": {
          "station": "desk",
          "state": "editing",
          "activity": "editing README.md",
          "taskId": "t6"
        }
      }
    },
    {
      "t": 3.7,
      "say": {
        "agent": "marlow",
        "text": "On it: README + help text for #tags"
      }
    }
  ]
}
